# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inspections
REDIS_URL=redis://localhost:6379/0
# Reserved for future auth (currently unused by code)
# SECRET_KEY=change-me-to-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Storage backend ───────────────────────────────────────────────
# Options: local (default), s3
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO, etc.)
# Only required when STORAGE_BACKEND=s3
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=tractor-ocr
S3_REGION=auto
# Public URL for serving images (R2 public bucket or custom domain)
S3_PUBLIC_URL=https://pub-<hash>.r2.dev

# ── Processing ────────────────────────────────────────────────────
WORKER_COUNT=8
PDF_DPI=300
MAX_PDF_PAGES=500
MAX_PAGE_WIDTH=5000
MAX_PAGE_HEIGHT=10000
MAX_UPLOAD_SIZE_MB=500
MAX_RETRY_COUNT=3
LOG_LEVEL=info
UVICORN_WORKERS=4
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
CELERY_QUEUES=default,ocr
CELERY_MAX_TASKS=1000
CELERY_MAX_MEMORY=500000

# ── Version tags ──────────────────────────────────────────────────
OCR_VERSION=paddleocr-3.7.0
AI_VERSION=mahindra-ai-v1.0
IMAGE_PIPELINE_VERSION=img-enhance-v1.0
